# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma. Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# Generate a long, random secret. Required for production; do not use the
# development fallback present in the source code.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only when running the Prisma seed to create the initial admin account.
# Keep this secret; the seed creates admin@nityanikunj.org if it does not exist.
ADMIN_BOOTSTRAP_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — one-time donations
# ─────────────────────────────────────────────────────────────────────────────
# Use test keys for test-mode checkout, then live keys for production payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Set the same webhook secret here and in Razorpay Dashboard > Webhooks.
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Outgoing email — SMTP (Resend-compatible)
# ─────────────────────────────────────────────────────────────────────────────
# Resend example: host=smtp.resend.com, port=465, user=resend,
# password=your Resend API key. Verify the EMAIL_FROM domain with your provider.
EMAIL_HOST="smtp.resend.com"
EMAIL_PORT="465"
EMAIL_USER="resend"
EMAIL_PASSWORD=""
EMAIL_FROM=""

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible uploads (Cloudflare R2 or other S3-compatible storage)
# ─────────────────────────────────────────────────────────────────────────────
# S3_ENDPOINT: S3 API endpoint (for R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
# S3_PUBLIC_URL: public bucket URL or connected custom domain for uploaded files.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Automatic content translation (optional; configure Google, LibreTranslate, or both)
# ─────────────────────────────────────────────────────────────────────────────
# Google is tried first when configured. LibreTranslate is used if Google is
# absent or fails. LibreTranslate API key is optional for instances that require it.
GOOGLE_TRANSLATE_API_KEY=""
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL
# ─────────────────────────────────────────────────────────────────────────────
# Used to build newsletter unsubscribe links. Defaults to
# https://shrinityanikunjtrust.org when unset.
NEXT_PUBLIC_BASE_URL="https://YOUR_DOMAIN"

# NODE_ENV is normally supplied by the hosting platform (development/production).
