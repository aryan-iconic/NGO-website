# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string for Prisma. Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Direct or Supabase session-pooler URL used only by `prisma migrate deploy`.
# Do not use Supabase's transaction pooler (port 6543) for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_SESSION_POOLER_HOST:5432/DATABASE?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# Generate a long, random secret. Required for production; do not use the
# development fallback present in the source code.
AUTH_SECRET="replace-with-a-long-random-secret"

# Used only when running the Prisma seed to create the initial admin account.
# Keep this secret; the seed creates admin@nityanikunj.org if it does not exist.
ADMIN_BOOTSTRAP_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — one-time donations
# ─────────────────────────────────────────────────────────────────────────────
# Use test keys for test-mode checkout, then live keys for production payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Set the same webhook secret here and in Razorpay Dashboard > Webhooks.
# Webhook endpoint: https://YOUR_DOMAIN/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Outgoing email — Resend API (preferred) or SMTP fallback
# Production Resend API setup: set RESEND_API_KEY and EMAIL_FROM.
# EMAIL_FROM must be a verified sender address. The contact form currently
# also sends admin notifications to EMAIL_FROM, so use a monitored inbox.
# When RESEND_API_KEY is present, the app uses the Resend API and ignores the
# SMTP variables below. If it is absent, all four SMTP variables are required.
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM=""
APP_URL="https://www.shrinityanikunjtrust.com"

# Optional SMTP fallback. For Resend SMTP: host=smtp.resend.com,
# port=465, user=resend, password=your Resend API key.
EMAIL_HOST=""
EMAIL_PORT="465"
EMAIL_USER=""
EMAIL_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# S3-compatible uploads (Cloudflare R2 or other S3-compatible storage)
# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 S3 API uploads. All six values are required by the upload route.
# S3_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION must be "auto" for Cloudflare R2.
# S3_PUBLIC_URL: public R2 custom domain/base URL, without a trailing slash.
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_PUBLIC_URL=""
# Optional AWS SDK path-style addressing override (normally leave unset for R2).
S3_FORCE_PATH_STYLE="false"

# ─────────────────────────────────────────────────────────────────────────────
# Automatic content translation (optional; configure Google, LibreTranslate, or both)
# ─────────────────────────────────────────────────────────────────────────────
# Google is tried first when configured. LibreTranslate is used if Google is
# absent or fails. LibreTranslate API key is optional for instances that require it.
GOOGLE_TRANSLATE_API_KEY=""
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL
# ─────────────────────────────────────────────────────────────────────────────
# Used to build newsletter unsubscribe links.
NEXT_PUBLIC_BASE_URL="https://www.shrinityanikunjtrust.com"

# NODE_ENV is normally supplied by the hosting platform (development/production).
