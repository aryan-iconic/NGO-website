// Shri Nityanikunj Trust — Prisma schema (MVP core models)
// Integer paise for all money. UUID PKs. created_at/updated_at everywhere.

generator client {
  provider = "prisma-client-js"
}

// Production datasource. Run `npx prisma migrate dev` against a real
// PostgreSQL instance to create these tables, then point the app's data
// layer (src/lib/db.ts) at Prisma instead of the in-memory/file store —
// the shapes match exactly, so it's a swap, not a rewrite.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DonationMode {
  PRODUCTS
  GENERAL
  BOTH
}

enum DonationStatus {
  CREATED
  PENDING_PAYMENT
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  phone           String?
  passwordHash    String    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  donations       Donation[]
  favorites       Favorite[]

  @@map("users")
}

model Admin {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             AdminRole @default(ADMIN)
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  mustChangePassword Boolean @default(true) @map("must_change_password")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  campaigns        Campaign[]

  @@map("admins")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  icon      String?
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  campaigns Campaign[]

  @@map("categories")
}

model SevaArea {
  id          String   @id @default(uuid())
  name        String
  hindiName   String?  @map("hindi_name")
  slug        String   @unique
  description String?
  icon        String?
  coverImage  String?  @map("cover_image")
  objectives  String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  campaigns   Campaign[]

  @@map("seva_areas")
}

model Campaign {
  id                  String         @id @default(uuid())
  title               String
  slug                String         @unique
  shortDescription    String         @map("short_description")
  story               String
  beneficiaryInfo      String?        @map("beneficiary_info")
  impactDescription    String?        @map("impact_description")
  categoryId          String?        @map("category_id")
  category            Category?      @relation(fields: [categoryId], references: [id])
  sevaAreaId          String?        @map("seva_area_id")
  sevaArea            SevaArea?      @relation(fields: [sevaAreaId], references: [id])
  locationText        String?        @map("location_text")
  coverImage           String?        @map("cover_image")
  status               CampaignStatus @default(DRAFT)
  isFeatured           Boolean        @default(false) @map("is_featured")
  isUrgent             Boolean        @default(false) @map("is_urgent")
  donationMode         DonationMode   @default(BOTH) @map("donation_mode")
  allowCustomAmount    Boolean        @default(true) @map("allow_custom_amount")
  minimumAmountPaise   Int            @default(10000) @map("minimum_amount_paise")
  taxBenefitEnabled    Boolean        @default(false) @map("tax_benefit_enabled")
  // JSON-encoded number[] (e.g. "[10100,50100,100100]"). Postgres could use native Int[].
  suggestedAmountsJson  String?        @map("suggested_amounts_json")
  startDate            DateTime?      @map("start_date")
  endDate              DateTime?      @map("end_date")
  createdByAdminId     String?        @map("created_by_admin_id")
  createdByAdmin       Admin?         @relation(fields: [createdByAdminId], references: [id])
  publishedAt          DateTime?      @map("published_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")

  financials  CampaignFinancials?
  products    CampaignProduct[]
  media       CampaignMedia[]
  updates     CampaignUpdate[]
  milestones  CampaignMilestone[]
  faqs        CampaignFaq[]
  donations   Donation[]
  favorites   Favorite[]

  @@index([status, categoryId, publishedAt])
  @@map("campaigns")
}

// Admin-only. Never imported by public-facing modules/queries.
model CampaignFinancials {
  campaignId          String   @id @map("campaign_id")
  campaign            Campaign @relation(fields: [campaignId], references: [id])
  internalTargetPaise BigInt?  @map("internal_target_paise")
  internalBudgetPaise BigInt?  @map("internal_budget_paise")
  notes               String?

  @@map("campaign_financials")
}

model CampaignProduct {
  id                String   @id @default(uuid())
  campaignId        String   @map("campaign_id")
  campaign          Campaign @relation(fields: [campaignId], references: [id])
  name              String
  description       String?
  image             String?
  unitName          String   @map("unit_name")
  pricePaise        Int      @map("price_paise")
  quantityLimit     Int?     @map("quantity_limit")
  quantityReserved  Int      @default(0) @map("quantity_reserved")
  quantitySponsored Int      @default(0) @map("quantity_sponsored")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")

  donationItems DonationItem[]

  @@index([campaignId, isActive])
  @@map("campaign_products")
}

model CampaignMedia {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  type       String   // IMAGE | VIDEO
  url        String
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")

  @@map("campaign_media")
}

model CampaignUpdate {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  title       String
  content     String
  coverImage  String?  @map("cover_image")
  publishedAt DateTime @default(now()) @map("published_at")

  @@map("campaign_updates")
}

model CampaignMilestone {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  title       String
  value       Int?
  unit        String?
  completed   Boolean  @default(false)
  completedAt DateTime? @map("completed_at")
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("campaign_milestones")
}

model CampaignFaq {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  question    String
  answer      String
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("campaign_faqs")
}

model Donation {
  id                String         @id @default(uuid())
  donationNumber    String         @unique @map("donation_number")
  userId            String?        @map("user_id")
  user              User?          @relation(fields: [userId], references: [id])
  campaignId        String?        @map("campaign_id")
  campaign          Campaign?      @relation(fields: [campaignId], references: [id])
  donorName         String         @map("donor_name")
  donorEmail        String         @map("donor_email")
  donorPhone        String?        @map("donor_phone")
  itemsTotalPaise   Int            @default(0) @map("items_total_paise")
  totalPaise        Int            @map("total_paise")
  status            DonationStatus @default(CREATED)
  isAnonymous       Boolean        @default(false) @map("is_anonymous")
  isGuest           Boolean        @default(true) @map("is_guest")
  idempotencyKey    String         @unique @map("idempotency_key")
  expiresAt         DateTime?      @map("expires_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  items    DonationItem[]
  payments Payment[]
  receipt  Receipt?

  @@index([userId, campaignId, status, createdAt])
  @@map("donations")
}

model DonationItem {
  id                    String           @id @default(uuid())
  donationId            String           @map("donation_id")
  donation              Donation         @relation(fields: [donationId], references: [id])
  campaignProductId     String?          @map("campaign_product_id")
  campaignProduct       CampaignProduct? @relation(fields: [campaignProductId], references: [id])
  productNameSnapshot   String           @map("product_name_snapshot")
  unitPriceSnapshotPaise Int             @map("unit_price_snapshot_paise")
  quantity              Int
  totalPaise            Int              @map("total_paise")

  @@map("donation_items")
}

model Payment {
  id               String        @id @default(uuid())
  donationId       String        @map("donation_id")
  donation         Donation      @relation(fields: [donationId], references: [id])
  gateway          String        @default("RAZORPAY")
  gatewayOrderId   String        @unique @map("gateway_order_id")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  amountPaise      Int           @map("amount_paise")
  status           PaymentStatus @default(CREATED)
  method           String?
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  events PaymentEvent[]

  @@map("payments")
}

model PaymentEvent {
  id             String   @id @default(uuid())
  paymentId      String   @map("payment_id")
  payment        Payment  @relation(fields: [paymentId], references: [id])
  eventType      String   @map("event_type")
  gatewayEventId String   @unique @map("gateway_event_id")
  payload        Json
  processed      Boolean  @default(false)
  receivedAt     DateTime @default(now()) @map("received_at")

  @@map("payment_events")
}

model Receipt {
  id            String    @id @default(uuid())
  receiptNumber String    @unique @map("receipt_number")
  donationId    String    @unique @map("donation_id")
  donation      Donation  @relation(fields: [donationId], references: [id])
  pdfAssetUrl   String?   @map("pdf_asset_url")
  generatedAt   DateTime  @default(now()) @map("generated_at")
  voidedAt      DateTime? @map("voided_at")

  @@map("receipts")
}

model Favorite {
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@id([userId, campaignId])
  @@map("favorites")
}

model VolunteerApplication {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  city         String?
  interests    String   // JSON-encoded string[]
  availability String?
  message      String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("volunteer_applications")
}

model Event {
  id                  String   @id @default(uuid())
  title               String
  slug                String   @unique
  description         String
  coverImage          String?  @map("cover_image")
  eventDate           DateTime @map("event_date")
  startTime            String?  @map("start_time")
  venue               String?
  location            String?
  organizer           String?
  registrationEnabled Boolean  @default(true) @map("registration_enabled")
  maxParticipants     Int?     @map("max_participants")
  status              String   @default("PUBLISHED") // DRAFT | PUBLISHED | CANCELLED | COMPLETED
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  event        Event    @relation(fields: [eventId], references: [id])
  name         String
  email        String
  phone        String?
  status       String   @default("CONFIRMED")
  registeredAt DateTime @default(now()) @map("registered_at")

  @@unique([eventId, email])
  @@map("event_registrations")
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?   @map("cover_image")
  author      String?
  status      String    @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Faq {
  id        String  @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  @@map("faqs")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW | READ | RESPONDED | CLOSED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
